# Copy to .env and edit. Never commit .env (it is git-ignored).
# Docker / docker compose reads this file; for a local run, export the variables or put them in your shell profile.
# Every variable is optional unless marked REQUIRED.

# --- Core -------------------------------------------------------------------
# development: random per-process SECRET_KEY if none is set, secure cookies off.
# production:  refuses to start without a strong SECRET_KEY; secure cookies on. The Docker image sets production.
APP_ENV=development

# REQUIRED in production. Signs the session cookie. At least 32 random characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everybody out.
SECRET_KEY=

# Database. Empty = SQLite file at seo-backend/instance/siktio.db, created automatically.
# Docker image default: sqlite:////data/siktio.db (a volume). SQLite is the only database the tests cover.
DATABASE_URL=

# Folder with the built web interface (seo-service-website/dist). Empty = found automatically in a repo checkout.
STATIC_DIR=

# Comma-separated list of browser origins allowed to call the API from another origin, e.g. http://localhost:5173
# Empty = no cross-origin access (the default; the site and API share one origin). "*" is refused.
CORS_ORIGINS=

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For/Proto/Host (needed for correct login throttling).
TRUST_PROXY_HEADERS=0

# --- Local development server (python -m src.main) --------------------------
HOST=127.0.0.1
PORT=5000
# Flask debugger. Only honoured on 127.0.0.1/localhost; never enable on a public interface.
FLASK_DEBUG=0

# --- Accounts and limits ----------------------------------------------------
# Set to 0 to stop new sign-ups (create accounts with: python -m src.manage create-user EMAIL).
ALLOW_REGISTRATION=1
# Plan given to a new account when none is chosen: starter (10 keywords), professional (25) or enterprise (50) per project.
# There is no billing; the plan only limits keywords per project.
DEFAULT_PLAN=starter
MAX_PROJECTS_PER_USER=10
# Cost protection: successful analyses per user per rolling 24 hours (each real analysis makes paid DataForSEO calls).
MAX_ANALYSES_PER_USER_PER_DAY=20
# Failed sign-ins allowed per address/account within the window before answering 429.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900
# Sign-up attempts per address per hour (each one costs a memory-hard password hash).
REGISTER_MAX_PER_HOUR=10
SESSION_LIFETIME_HOURS=168
# Default: on in production, off otherwise. Set to 0 only to test a production build over plain http.
SESSION_COOKIE_SECURE=

# --- Rank / SERP data -------------------------------------------------------
# auto = DataForSEO when both credentials below are set, otherwise the SAMPLE provider (invented, labelled data).
# sample = always sample data. dataforseo = real data; refuses to start without credentials.
RANK_PROVIDER=auto
# From app.dataforseo.com -> API access. The API password is not your account password. Set both or neither.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_TIMEOUT_SECONDS=60
# Retries for rate limits (HTTP 429, status 40202/40209) and transient server errors, with exponential backoff.
DATAFORSEO_MAX_RETRIES=3
# How many Google results to fetch per keyword (10-100). More results can cost more per keyword.
SERP_DEPTH=20
# Defaults for new projects. Location is a DataForSEO location name; language is a code such as sv or en.
DEFAULT_LOCATION_NAME=Sweden
DEFAULT_LANGUAGE_CODE=sv

# --- Report text ------------------------------------------------------------
# auto = OpenAI when OPENAI_API_KEY is set, otherwise a deterministic template report that says it is a template.
# template = never call OpenAI. openai = require OPENAI_API_KEY.
REPORT_GENERATOR=auto
OPENAI_API_KEY=
# Chat model name. Use one your OpenAI account can access; the default is not verified against the live API.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
